{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": 
    [
        {
            "command": 
            {
                "action": "newTab",
                "profile": "Git Bash"
            },
            "id": "User.newTab.AB5EC4B0"
        },
        {
            "command": 
            {
                "action": "newTab",
                "profile": "PowerShell"
            },
            "id": "User.newTab.B958D21E"
        },
        {
            "command": 
            {
                "action": "newTab",
                "profile": "Claude Code"
            },
            "id": "User.newTab.2F400C0F"
        }
    ],
    "alwaysShowTabs": true,
    "copyFormatting": "none",
    "copyOnSelect": true,
    "defaultProfile": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
    "disableAnimations": false,
    "focusFollowMouse": false,
    "initialCols": 140,
    "initialRows": 36,
    "keybindings": 
    [
        {
            "id": "Terminal.CopyToClipboard",
            "keys": "ctrl+shift+c"
        },
        {
            "id": "Terminal.PasteFromClipboard",
            "keys": "ctrl+shift+v"
        },
        {
            "id": "Terminal.FindText",
            "keys": "ctrl+shift+f"
        },
        {
            "id": "Terminal.OpenSettingsFile",
            "keys": "ctrl+comma"
        },
        {
            "id": "Terminal.TogglePaneZoom",
            "keys": "ctrl+shift+z"
        },
        {
            "id": "User.newTab.AB5EC4B0",
            "keys": "ctrl+shift+3"
        },
        {
            "id": "Terminal.DecreaseFontSize",
            "keys": "ctrl+minus"
        },
        {
            "id": "Terminal.IncreaseFontSize",
            "keys": "ctrl+plus"
        },
        {
            "id": "Terminal.DuplicatePaneRight",
            "keys": "alt+shift+d"
        },
        {
            "id": "Terminal.ToggleCommandPalette",
            "keys": "ctrl+shift+p"
        },
        {
            "id": "Terminal.ToggleFullscreen",
            "keys": "f11"
        },
        {
            "id": "Terminal.DuplicatePaneDown",
            "keys": "alt+shift+s"
        },
        {
            "id": "Terminal.ClosePane",
            "keys": "ctrl+shift+w"
        },
        {
            "id": "Terminal.MoveFocusLeft",
            "keys": "alt+left"
        },
        {
            "id": "Terminal.MoveFocusRight",
            "keys": "alt+right"
        },
        {
            "id": "Terminal.MoveFocusUp",
            "keys": "alt+up"
        },
        {
            "id": "Terminal.MoveFocusDown",
            "keys": "alt+down"
        },
        {
            "id": "Terminal.ResizePaneLeft",
            "keys": "ctrl+alt+left"
        },
        {
            "id": "Terminal.ResizePaneRight",
            "keys": "ctrl+alt+right"
        },
        {
            "id": "Terminal.ResizePaneUp",
            "keys": "ctrl+alt+up"
        },
        {
            "id": "Terminal.ResizePaneDown",
            "keys": "ctrl+alt+down"
        },
        {
            "id": "User.newTab.2F400C0F",
            "keys": "ctrl+shift+2"
        },
        {
            "id": "Terminal.ResetFontSize",
            "keys": "ctrl+0"
        },
        {
            "id": "User.newTab.B958D21E",
            "keys": "ctrl+shift+1"
        },
        {
            "id": "Terminal.ScrollToTop",
            "keys": "ctrl+home"
        },
        {
            "id": "Terminal.ScrollToBottom",
            "keys": "ctrl+end"
        },
        {
            "id": "Terminal.ClearBuffer",
            "keys": "ctrl+shift+k"
        }
    ],
    "launchMode": "default",
    "newTabMenu": 
    [
        {
            "type": "remainingProfiles"
        }
    ],
    "profiles": 
    {
        "defaults": 
        {
            "adjustIndistinguishableColors": "never",
            "altGrAliasing": true,
            "antialiasingMode": "grayscale",
            "bellStyle": "none",
            "colorScheme": "Nightdrive",
            "cursorShape": "filledBox",
            "experimental.retroTerminalEffect": false,
            "font": 
            {
                "face": "JetBrainsMono NFM",
                "features": 
                {
                    "calt": 1,
                    "liga": 1
                },
                "size": 11,
                "weight": "normal"
            },
            "historySize": 20000,
            "intenseTextStyle": "bold",
            "opacity": 88,
            "padding": "14, 12, 14, 12",
            "scrollbarState": "visible",
            "snapOnInput": true,
            "startingDirectory": "%USERPROFILE%",
            "useAcrylic": true
        },
        "list": 
        [
            {
                "commandline": "powershell.exe -NoLogo",
                "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                "hidden": false,
                "icon": "\u26a1",
                "name": "PowerShell",
                "tabTitle": "PowerShell"
            },
            {
                "colorScheme": "Nightdrive Void",
                "commandline": "powershell.exe -NoLogo -NoExit -Command \"claude\"",
                "environment": 
                {
                    "NIGHTDRIVE_QUIET": "1"
                },
                "guid": "{7b2c1f4e-9a3d-4c88-b1e6-0d5a72f9c410}",
                "hidden": false,
                "icon": "\ud83e\udde0",
                "name": "Claude Code",
                "opacity": 94,
                "startingDirectory": "%USERPROFILE%"
            },
            {
                "colorScheme": "Nightdrive",
                "commandline": "\"%ProgramFiles%\\Git\\bin\\bash.exe\" --login -i",
                "guid": "{3a8f6d21-5e74-4b0c-9f13-2c6b8e40da97}",
                "hidden": false,
                "icon": "\ud83c\udf3f",
                "name": "Git Bash",
                "startingDirectory": "%USERPROFILE%"
            },
            {
                "colorScheme": "Nightdrive Void",
                "commandline": "%SystemRoot%\\System32\\cmd.exe",
                "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
                "hidden": false,
                "icon": "\ud83d\udda5\ufe0f",
                "name": "Command Prompt"
            },
            {
                "guid": "{b453ae62-4e3d-5e58-b989-0a998ec441b8}",
                "hidden": true,
                "name": "Azure Cloud Shell",
                "source": "Windows.Terminal.Azure"
            }
        ]
    },
